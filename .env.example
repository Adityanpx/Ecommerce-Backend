# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ============================================
# DATABASE (Supabase PostgreSQL)
# DATABASE_URL  = pooled connection  (port 6543, pgbouncer)
# DIRECT_URL    = direct connection  (port 5432, migrations)
# ============================================
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ============================================
# JWT — CUSTOMER
# Generate each with: openssl rand -base64 48
# ============================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# JWT — ADMIN (must be different from customer secrets)
# ============================================
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_ACCESS_EXPIRY=15m
ADMIN_JWT_REFRESH_EXPIRY=7d

# ============================================
# SECURITY
# ============================================
BCRYPT_SALT_ROUNDS=12
COOKIE_SECRET=

# ============================================
# CORS
# ============================================
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sportstore

# ============================================
# CLOUDFLARE R2 (S3-compatible object storage)
# ============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=ecommerce-sportstore-media
R2_PRIVATE_BUCKET=ecommerce-sportstore-media-private
R2_PUBLIC_BASE_URL=

# ============================================
# RAZORPAY
# ============================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================
# MSG91 (SMS / OTP)
# ============================================
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_ORDER_TEMPLATE_ID=
MSG91_SHIPPED_TEMPLATE_ID=
MSG91_DELIVERED_TEMPLATE_ID=

# ============================================
# RESEND (Email)
# ============================================
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Sports Store
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# ============================================
# SENTRY (leave blank in local dev to disable)
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# MEILISEARCH
# ============================================
MEILISEARCH_HOST=https://ms-d36c5283b81c-54435.sgp.meilisearch.io
MEILISEARCH_API_KEY=your_admin_api_key_here

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
