generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AdminRole {
  SUPER_ADMIN
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  VERIFY_PHONE
}

enum AttributeType {
  TEXT
  NUMBER
  DROPDOWN
  MULTI_SELECT
  BOOLEAN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RazorpayPaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum ReturnReason {
  WRONG_SIZE
  DAMAGED
  DEFECTIVE
  NOT_AS_DESCRIBED
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUND_PROCESSED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
}

enum BannerPosition {
  HERO
  CAROUSEL
  PROMO_MID
}

enum CollectionType {
  CURATED
  TRENDING
  BEST_SELLERS
  NEW_ARRIVALS
}

enum StockMovementReason {
  MANUAL_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  RETURN_RECEIVED
  RESTOCK
  CORRECTION
  DAMAGED
  INITIAL_STOCK
}

enum ProductRelationType {
  RELATED
  BOUGHT_TOGETHER
}

// ============================================================
// AUTHENTICATION
// ============================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique @db.VarChar(255)
  phone         String?   @unique @db.VarChar(15)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String?   @map("last_name") @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url") @db.Text
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  returns             Return[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  couponUsages        CouponUsage[]
  wishlist            Wishlist?

  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@map("users")
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(150)
  role         AdminRole @default(SUPER_ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens      RefreshToken[]
  orderStatusChanges OrderStatusHistory[]
  productDrafts      ProductDraft[]

  @@index([email])
  @@map("admins")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userId    String?   @map("user_id") @db.Uuid
  adminId   String?   @map("admin_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent") @db.Text
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([adminId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String     @db.VarChar(15)
  codeHash   String     @map("code_hash") @db.VarChar(255)
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_codes")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ============================================================
// CATALOG
// ============================================================

model Sport {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(120)
  slug                 String   @unique @db.VarChar(140)
  description          String?  @db.Text
  iconUrl              String?  @map("icon_url") @db.Text
  bannerUrl            String?  @map("banner_url") @db.Text
  heroTitle            String?  @map("hero_title") @db.VarChar(255)
  heroSubtitle         String?  @map("hero_subtitle") @db.VarChar(255)
  heroDescription      String?  @map("hero_description") @db.Text
  heroCtaText          String?  @map("hero_cta_text") @db.VarChar(100)
  heroCtaLink          String?  @map("hero_cta_link") @db.Text
  heroSecondaryCtaText String?  @map("hero_secondary_cta_text") @db.VarChar(100)
  heroSecondaryCtaLink String?  @map("hero_secondary_cta_link") @db.Text
  heroBadges           String[] @default([]) @map("hero_badges")
  highlights           Json?
  displayOrder         Int      @default(0) @map("display_order")
  isActive             Boolean  @default(true) @map("is_active")
  metaTitle            String?  @map("meta_title") @db.VarChar(255)
  metaDescription      String?  @map("meta_description") @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subCategories SubCategory[]
  collections   Collection[]
  testimonials  Testimonial[]

  @@index([slug])
  @@index([isActive, displayOrder])
  @@map("sports")
}

model SubCategory {
  id              String   @id @default(uuid()) @db.Uuid
  sportId         String   @map("sport_id") @db.Uuid
  name            String   @db.VarChar(120)
  slug            String   @db.VarChar(140)
  description     String?  @db.Text
  imageUrl        String?  @map("image_url") @db.Text
  gstRate         Decimal? @map("gst_rate") @db.Decimal(5, 2)
  displayOrder    Int      @default(0) @map("display_order")
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sport       Sport               @relation(fields: [sportId], references: [id], onDelete: Cascade)
  attributes  CategoryAttribute[]
  products    Product[]
  sizeChart   SizeChartTemplate?
  sizePresets SizePreset[]

  @@unique([sportId, slug])
  @@index([sportId])
  @@index([slug])
  @@map("sub_categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  logoUrl     String?  @map("logo_url") @db.Text
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@index([slug])
  @@index([isActive])
  @@map("brands")
}

/// Defines one custom field that products in a sub-category will have.
/// This is what allows the catalog to support any sport without schema changes.
model CategoryAttribute {
  id            String        @id @default(uuid()) @db.Uuid
  subCategoryId String        @map("sub_category_id") @db.Uuid
  name          String        @db.VarChar(120)
  code          String        @db.VarChar(120)
  type          AttributeType
  options       Json?
  unit          String?       @db.VarChar(20)
  isRequired    Boolean       @default(false) @map("is_required")
  isFilterable  Boolean       @default(false) @map("is_filterable")
  displayOrder  Int           @default(0) @map("display_order")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  subCategory SubCategory             @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  values      ProductAttributeValue[]

  @@unique([subCategoryId, code])
  @@index([subCategoryId])
  @@index([isFilterable])
  @@map("category_attributes")
}

model Product {
  id                  String        @id @default(uuid()) @db.Uuid
  subCategoryId       String        @map("sub_category_id") @db.Uuid
  brandId             String?       @map("brand_id") @db.Uuid
  name                String        @db.VarChar(255)
  slug                String        @unique @db.VarChar(280)
  brand               String?       @db.VarChar(120)
  description         String?       @db.Text
  shortDescription    String?       @map("short_description") @db.VarChar(500)
  mrp                 Decimal       @db.Decimal(10, 2)
  sellingPrice        Decimal       @map("selling_price") @db.Decimal(10, 2)
  costPrice           Decimal?      @map("cost_price") @db.Decimal(10, 2)
  skuPrefix           String        @map("sku_prefix") @db.VarChar(50)
  hsnCode             String?       @map("hsn_code") @db.VarChar(20)
  gstRate             Decimal?      @map("gst_rate") @db.Decimal(5, 2)
  weightGrams         Int?          @map("weight_grams")
  isOversized         Boolean       @default(false) @map("is_oversized")
  shippingCharge      Decimal?      @map("shipping_charge") @db.Decimal(10, 2)
  packageContents     String[]      @default([]) @map("package_contents")
  highlights          String[]      @default([])
  /// null = auto-detect the size chart, 'none' = no size guide, otherwise a built-in chart key.
  sizeChartKey        String?       @map("size_chart_key") @db.VarChar(60)
  /// Label shown next to the size picker, e.g. "EU MEN", "UK", "Inches". Free text.
  sizeSystem          String?       @map("size_system") @db.VarChar(30)
  /// Optional product video — an uploaded R2 URL or a YouTube/Vimeo link.
  videoUrl            String?       @map("video_url") @db.Text
  /// Merchandising badges (New, Bestseller, Limited...). Stored trimmed, original casing.
  tags                String[]      @default([])
  /// Extra lower-cased words the storefront search should match (synonyms, model codes).
  searchKeywords      String[]      @default([]) @map("search_keywords")
  /// Max units of this product (all variants combined) per order. null = platform default.
  maxOrderQuantity    Int?          @map("max_order_quantity")
  isReturnable        Boolean       @default(true) @map("is_returnable")
  /// Overrides the platform return window for this product. null = platform default.
  returnWindowDays    Int?          @map("return_window_days")
  codAvailable        Boolean       @default(true) @map("cod_available")
  // ---- Legal disclosures (Consumer Protection (E-Commerce) Rules / Legal Metrology) ----
  countryOfOrigin     String?       @map("country_of_origin") @db.VarChar(80)
  manufacturerDetails String?       @map("manufacturer_details") @db.Text
  packerDetails       String?       @map("packer_details") @db.Text
  importerDetails     String?       @map("importer_details") @db.Text
  netQuantity         String?       @map("net_quantity") @db.VarChar(60)
  warrantyInfo        String?       @map("warranty_info") @db.VarChar(255)
  status              ProductStatus @default(DRAFT)
  orderCount          Int           @default(0) @map("order_count")
  metaTitle           String?       @map("meta_title") @db.VarChar(255)
  metaDescription     String?       @map("meta_description") @db.Text
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  subCategory     SubCategory             @relation(fields: [subCategoryId], references: [id])
  brandRef        Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  bannerFeatures  Banner[]
  collectionLinks CollectionProduct[]
  spotlights      FeaturedSpotlight[]
  wishlistItems   WishlistItem[]
  colors          ProductColor[]
  relationsFrom   ProductRelation[]       @relation("ProductRelationSource")
  relationsTo     ProductRelation[]       @relation("ProductRelationTarget")
  drafts          ProductDraft[]

  @@index([slug])
  @@index([subCategoryId])
  @@index([tags], type: Gin)
  @@index([searchKeywords], type: Gin)
  @@index([brandId])
  @@index([status])
  @@index([brand])
  @@index([sellingPrice])
  @@index([orderCount])
  @@index([deletedAt])
  @@map("products")
}

/// Actual attribute data for a product, against a CategoryAttribute definition.
/// Typed columns (not one text column) so numeric range filters can use an index.
model ProductAttributeValue {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  attributeId  String   @map("attribute_id") @db.Uuid
  valueText    String?  @map("value_text") @db.Text
  valueNumber  Decimal? @map("value_number") @db.Decimal(12, 3)
  valueBoolean Boolean? @map("value_boolean")
  valueJson    Json?    @map("value_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId, valueNumber])
  @@index([attributeId, valueText])
  @@map("product_attribute_values")
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  /// The colour group this variant belongs to. null only for products that have no colours.
  colorId           String?  @map("color_id") @db.Uuid
  sku               String   @unique @db.VarChar(80)
  /// EAN / UPC / GTIN. Optional, unique when present.
  barcode           String?  @unique @db.VarChar(64)
  size              String?  @db.VarChar(50)
  /// Denormalised copy of ProductColor.name — kept in sync by productColorService.
  /// Order snapshots, low-stock mails and the dashboard SQL read this column.
  color             String?  @db.VarChar(50)
  colorHex          String?  @map("color_hex") @db.VarChar(7)
  priceOverride     Decimal? @map("price_override") @db.Decimal(10, 2)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  imageUrl          String?  @map("image_url") @db.Text
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorRef       ProductColor?   @relation(fields: [colorId], references: [id], onDelete: Restrict)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([colorId])
  @@index([sku])
  @@index([stock])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  /// null = shared image shown for every colour; otherwise the colour this photo belongs to.
  colorId      String?  @map("color_id") @db.Uuid
  url          String   @db.Text
  publicId     String   @map("public_id") @db.VarChar(255)
  altText      String?  @map("alt_text") @db.VarChar(255)
  /// Pixel size + bytes reported by the admin uploader; drives the low-resolution warning.
  width        Int?
  height       Int?
  sizeBytes    Int?     @map("size_bytes")
  displayOrder Int      @default(0) @map("display_order")
  /// Exactly one per product: the cover used on listing cards, cart and wishlist.
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@index([colorId, displayOrder])
  @@index([publicId])
  @@map("product_images")
}

/// One colourway of a product ("Chalk White / Pure Grey"). Owns its photos, optional
/// own pricing, and groups the size variants sold in that colour.
model ProductColor {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  /// Library swatch this colour was picked from (null = custom colour).
  swatchId     String?  @map("swatch_id") @db.Uuid
  name         String   @db.VarChar(50)
  hex          String?  @db.VarChar(7)
  /// Second tone for two-colour colourways.
  secondaryHex String?  @map("secondary_hex") @db.VarChar(7)
  /// null = inherit the product's MRP / selling / cost price.
  mrp          Decimal? @db.Decimal(10, 2)
  sellingPrice Decimal? @map("selling_price") @db.Decimal(10, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  swatch   ColorSwatch?     @relation(fields: [swatchId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]

  @@unique([productId, name])
  @@index([productId, displayOrder])
  @@map("product_colors")
}

/// Admin's reusable colour library. Picking a swatch pre-fills name + hex on a ProductColor.
model ColorSwatch {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(50)
  hex          String   @db.VarChar(7)
  secondaryHex String?  @map("secondary_hex") @db.VarChar(7)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  productColors ProductColor[]

  @@index([isActive])
  @@map("color_swatches")
}

/// Reusable size sets ("S–XXL", "UK 6–11"). Optionally suggested for one sub-category.
model SizePreset {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(80)
  sizeSystem    String?  @map("size_system") @db.VarChar(30)
  sizes         String[]
  subCategoryId String?  @map("sub_category_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  @@index([subCategoryId])
  @@map("size_presets")
}

/// Manually curated "related" and "frequently bought together" links. Directional.
model ProductRelation {
  id               String              @id @default(uuid()) @db.Uuid
  productId        String              @map("product_id") @db.Uuid
  relatedProductId String              @map("related_product_id") @db.Uuid
  type             ProductRelationType
  displayOrder     Int                 @default(0) @map("display_order")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  product        Product @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, type])
  @@index([productId, type, displayOrder])
  @@map("product_relations")
}

/// Autosaved admin product-form state. `id` is generated by the admin client so the
/// autosave PUT is idempotent. productId is set when the draft is an edit of a live product.
model ProductDraft {
  id        String   @id @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  title     String?  @db.VarChar(255)
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  admin   Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([adminId, updatedAt])
  @@map("product_drafts")
}

/// Defines the size chart format for a sub-category.
/// E.g. Cricket Bats might have columns: ["Height (inches)", "Width (mm)", "Weight Range (gm)"]
/// and rows for each size label: "SH", "Size 6", "Full Size", "Long Handle".
model SizeChartTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  subCategoryId String   @unique @map("sub_category_id") @db.Uuid
  title         String   @db.VarChar(150)
  columns       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subCategory SubCategory      @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  entries     SizeChartEntry[]

  @@map("size_chart_templates")
}

model SizeChartEntry {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  sizeLabel  String @map("size_label") @db.VarChar(50)
  values     Json
  sortOrder  Int    @default(0) @map("sort_order")

  template SizeChartTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sizeLabel])
  @@index([templateId, sortOrder])
  @@map("size_chart_entries")
}

/// Audit log for every stock change on a variant.
model StockMovement {
  id            String              @id @default(uuid()) @db.Uuid
  variantId     String              @map("variant_id") @db.Uuid
  reason        StockMovementReason
  quantityDelta Int                 @map("quantity_delta")
  stockBefore   Int                 @map("stock_before")
  stockAfter    Int                 @map("stock_after")
  note          String?             @db.Text
  /// Admin who made a manual change. null for system movements (orders, returns, jobs).
  adminId       String?             @map("admin_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

model Promotion {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @db.VarChar(150)
  slug          String       @unique @db.VarChar(170)
  description   String?      @db.Text
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  /// Which products does this apply to?
  /// ALL = entire catalog, CATEGORY = specific subcategories, PRODUCT = specific products
  scope         CouponScope  @default(ALL)
  /// Array of subCategoryIds or productIds depending on scope
  scopeIds      Json?        @map("scope_ids")
  startsAt      DateTime     @map("starts_at") @db.Timestamptz
  endsAt        DateTime     @map("ends_at") @db.Timestamptz
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, startsAt, endsAt])
  @@index([scope])
  @@map("promotions")
}

// ============================================================
// CART
// ============================================================

model Cart {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @unique @map("user_id") @db.Uuid
  guestToken String?   @unique @map("guest_token") @db.VarChar(100)
  couponId   String?   @map("coupon_id") @db.Uuid
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@index([userId])
  @@index([guestToken])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id              String   @id @default(uuid()) @db.Uuid
  cartId          String   @map("cart_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  quantity        Int
  isSavedForLater Boolean  @default(false) @map("is_saved_for_later")
  addedAt         DateTime @default(now()) @map("added_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  orderNumber        String        @unique @map("order_number") @db.VarChar(30)
  userId             String?       @map("user_id") @db.Uuid
  guestEmail         String?       @map("guest_email") @db.VarChar(255)
  guestPhone         String?       @map("guest_phone") @db.VarChar(15)
  status             OrderStatus   @default(PENDING_PAYMENT)
  subtotal           Decimal       @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  couponId           String?       @map("coupon_id") @db.Uuid
  couponCode         String?       @map("coupon_code") @db.VarChar(50)
  shippingCharge     Decimal       @default(0) @map("shipping_charge") @db.Decimal(10, 2)
  taxAmount          Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentMethod      PaymentMethod @map("payment_method")
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  shippingAddress    Json          @map("shipping_address")
  billingAddress     Json?         @map("billing_address")
  courierName        String?       @map("courier_name") @db.VarChar(120)
  trackingNumber     String?       @map("tracking_number") @db.VarChar(120)
  trackingUrl        String?       @map("tracking_url") @db.Text
  invoiceNumber      String?       @unique @map("invoice_number") @db.VarChar(40)
  invoiceUrl         String?       @map("invoice_url") @db.Text
  cancellationReason String?       @map("cancellation_reason") @db.Text
  placedAt           DateTime?     @map("placed_at") @db.Timestamptz
  shippedAt          DateTime?     @map("shipped_at") @db.Timestamptz
  deliveredAt        DateTime?     @map("delivered_at") @db.Timestamptz
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user          User?                @relation(fields: [userId], references: [id])
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  returns       Return[]
  couponUsages  CouponUsage[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

/// All product data is snapshotted so renaming or deleting a product
/// never changes historical orders or invoices.
model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  productName      String  @map("product_name") @db.VarChar(255)
  variantLabel     String  @map("variant_label") @db.VarChar(120)
  sku              String  @db.VarChar(80)
  imageUrl         String? @map("image_url") @db.Text
  hsnCode          String? @map("hsn_code") @db.VarChar(20)
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity         Int
  gstRate          Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(10, 2)
  /// Return rules snapshotted at purchase so later product edits never change them.
  isReturnable     Boolean @default(true) @map("is_returnable")
  returnWindowDays Int?    @map("return_window_days")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  fromStatus       OrderStatus? @map("from_status")
  toStatus         OrderStatus  @map("to_status")
  note             String?      @db.Text
  changedByAdminId String?      @map("changed_by_admin_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByAdmin Admin? @relation(fields: [changedByAdminId], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id                String                @id @default(uuid()) @db.Uuid
  orderId           String                @map("order_id") @db.Uuid
  razorpayOrderId   String?               @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?               @unique @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature String?               @map("razorpay_signature") @db.VarChar(255)
  amount            Decimal               @db.Decimal(10, 2)
  currency          String                @default("INR") @db.VarChar(3)
  method            String?               @db.VarChar(50)
  status            RazorpayPaymentStatus @default(CREATED)
  failureReason     String?               @map("failure_reason") @db.Text
  rawPayload        Json?                 @map("raw_payload")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([razorpayOrderId])
  @@map("payments")
}

// ============================================================
// RETURNS
// ============================================================

model Return {
  id               String       @id @default(uuid()) @db.Uuid
  returnNumber     String       @unique @map("return_number") @db.VarChar(30)
  orderId          String       @map("order_id") @db.Uuid
  userId           String?      @map("user_id") @db.Uuid
  reason           ReturnReason
  reasonNote       String?      @map("reason_note") @db.Text
  images           Json?
  status           ReturnStatus @default(REQUESTED)
  adminNote        String?      @map("admin_note") @db.Text
  refundAmount     Decimal?     @map("refund_amount") @db.Decimal(10, 2)
  razorpayRefundId String?      @map("razorpay_refund_id") @db.VarChar(100)
  requestedAt      DateTime     @default(now()) @map("requested_at") @db.Timestamptz
  resolvedAt       DateTime?    @map("resolved_at") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  order Order        @relation(fields: [orderId], references: [id])
  user  User?        @relation(fields: [userId], references: [id])
  items ReturnItem[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id          String @id @default(uuid()) @db.Uuid
  returnId    String @map("return_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
  @@map("return_items")
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique @db.VarChar(50)
  description       String?      @db.VarChar(255)
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(10, 2)
  minCartValue      Decimal      @default(0) @map("min_cart_value") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(10, 2)
  scope             CouponScope  @default(ALL)
  scopeIds          Json?        @map("scope_ids")
  usageLimitTotal   Int?         @map("usage_limit_total")
  usageLimitPerUser Int          @default(1) @map("usage_limit_per_user")
  usedCount         Int          @default(0) @map("used_count")
  validFrom         DateTime     @map("valid_from") @db.Timestamptz
  validTo           DateTime     @map("valid_to") @db.Timestamptz
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  carts  Cart[]
  orders Order[]
  usages CouponUsage[]

  @@index([code])
  @@index([isActive, validFrom, validTo])
  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(uuid()) @db.Uuid
  couponId        String   @map("coupon_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  discountApplied Decimal  @map("discount_applied") @db.Decimal(10, 2)
  usedAt          DateTime @default(now()) @map("used_at") @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([orderId])
  @@map("coupon_usages")
}

// ============================================================
// SUPPORTING
// ============================================================

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @default("Home") @db.VarChar(50)
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String   @db.VarChar(15)
  line1     String   @db.VarChar(255)
  line2     String?  @db.VarChar(255)
  landmark  String?  @db.VarChar(150)
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  pincode   String   @db.VarChar(10)
  country   String   @default("India") @db.VarChar(100)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pincode])
  @@map("addresses")
}

/// Key-value store for all admin-configurable platform settings.
/// Avoids a migration every time a new setting is introduced.
model Setting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

model Banner {
  id                String         @id @default(uuid()) @db.Uuid
  title             String?        @db.VarChar(150)
  imageUrl          String         @map("image_url") @db.Text
  mobileImageUrl    String?        @map("mobile_image_url") @db.Text
  publicId          String         @map("public_id") @db.VarChar(255)
  linkUrl           String?        @map("link_url") @db.Text
  subtitle          String?        @db.VarChar(255)
  description       String?        @db.Text
  ctaText           String?        @map("cta_text") @db.VarChar(100)
  ctaLink           String?        @map("cta_link") @db.Text
  secondaryCtaText  String?        @map("secondary_cta_text") @db.VarChar(100)
  secondaryCtaLink  String?        @map("secondary_cta_link") @db.Text
  position          BannerPosition @default(CAROUSEL)
  featuredProductId String?        @map("featured_product_id") @db.Uuid
  displayOrder      Int            @default(0) @map("display_order")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  featuredProduct Product? @relation(fields: [featuredProductId], references: [id], onDelete: SetNull)

  @@index([position, isActive, displayOrder])
  @@map("banners")
}

model StaticPage {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique @db.VarChar(100)
  title           String   @db.VarChar(200)
  content         String   @db.Text
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  isPublished     Boolean  @default(true) @map("is_published")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([slug])
  @@map("static_pages")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(15)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

// ============================================================
// HOMEPAGE & MARKETING CONTENT
// ============================================================

model AnnouncementItem {
  id           String   @id @default(uuid()) @db.Uuid
  text         String   @db.VarChar(255)
  linkUrl      String?  @map("link_url") @db.Text
  linkText     String?  @map("link_text") @db.VarChar(100)
  emoji        String?  @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, displayOrder])
  @@map("announcement_items")
}

model TrustBadge {
  id           String   @id @default(uuid()) @db.Uuid
  icon         String   @db.VarChar(50)
  title        String   @db.VarChar(120)
  subtitle     String?  @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, displayOrder])
  @@map("trust_badges")
}

model Testimonial {
  id           String   @id @default(uuid()) @db.Uuid
  authorName   String   @map("author_name") @db.VarChar(150)
  authorTitle  String?  @map("author_title") @db.VarChar(150)
  authorAvatar String?  @map("author_avatar") @db.Text
  rating       Decimal  @db.Decimal(2, 1)
  text         String   @db.Text
  sportId      String?  @map("sport_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sport Sport? @relation(fields: [sportId], references: [id], onDelete: SetNull)

  @@index([isActive, displayOrder])
  @@index([sportId])
  @@map("testimonials")
}

model Collection {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(150)
  slug         String         @unique @db.VarChar(170)
  type         CollectionType @default(CURATED)
  description  String?        @db.Text
  sportId      String?        @map("sport_id") @db.Uuid
  imageUrl     String?        @map("image_url") @db.Text
  isActive     Boolean        @default(true) @map("is_active")
  displayOrder Int            @default(0) @map("display_order")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  sport    Sport?              @relation(fields: [sportId], references: [id], onDelete: SetNull)
  products CollectionProduct[]

  @@index([isActive, displayOrder])
  @@index([sportId])
  @@index([slug])
  @@map("collections")
}

model CollectionProduct {
  id           String @id @default(uuid()) @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  displayOrder Int    @default(0) @map("display_order")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, displayOrder])
  @@map("collection_products")
}

model FeaturedSpotlight {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  title       String?  @db.VarChar(255)
  subtitle    String?  @db.VarChar(255)
  description String?  @db.Text
  productId   String   @map("product_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([key])
  @@map("featured_spotlights")
}
